From: Captain-Tripps
Subject: [PATCH] sycl prefill: B70 GDN prompt-path kernels from Strata PR #6566 (opt-in)

A port of the B70 GDN prompt-path pieces of Strata PR #6566
(https://github.com/Niko1221/Strata/pull/6566) into this tree's older prefill
layout. Three switches, all off by default; off is the old code path:

  STRATA_B70_GDN_PAIR=1   GDN recurrence with q / k held in registers and two
                          tokens' inputs loaded before the first one's update
                          (16-lane sub-group, T >= 128, Xe devices only).
  STRATA_B70_GDN_CONV=1   conv + silu + q / k L2 norm, one sub-group per head,
                          8 tokens a group (T >= 512).
  STRATA_B70_GDN_RESID=1  GDN layers' attention-half residual write + the next
                          norm, 2 channels a work-item (T >= 512).

Each keeps the existing kernels' per-column sum order, so the output should
not change. Measured with the engine bench (32,768-token prompt, 16 greedy
tokens after it, 2 cards, 3 warm runs an arm): stock IQ3_S read 2,260 ->
2,407 tok/s (+6.5%), abliterated 2,245 -> 2,419 (+7.7%), output tokens
identical in every arm. All of the gain is STRATA_B70_GDN_PAIR; CONV and RESID
alone are within noise (2,272 / 2,273 vs 2,260). Decode is not affected: the
switches fire only at T >= 128.

Not ported: the BF16 projection tile (this tree has no deterministic GEMM
there) and the SWAR sign trick (0-3% at best upstream).

---
diff --git a/sycl/src/prefill/b70_gdn_residual.hpp b/sycl/src/prefill/b70_gdn_residual.hpp
new file mode 100644
index 0000000..4cb4697
--- /dev/null
+++ b/sycl/src/prefill/b70_gdn_residual.hpp
@@ -0,0 +1,72 @@
+#pragma once
+// SYCL port (STRATA_B70_GDN_RESID, from Strata PR #6566 bmg_gdn_residual.hpp): gr_write_norm_rs_kernel with two
+// channels a work-item (128 work-items, sub-group 16). Thread i holds original threads 2i and 2i + 1: the same
+// per-thread squares, the xor steps 16..2 then the pair add (= the old xor 1), the 8 warp sums over xor 4, 2, 1.
+#include <sycl/sycl.hpp>
+#include <cstdint>
+namespace strata::prefill::b70_gdn_residual {
+constexpr int N = 2560, HC = 4;
+inline uint16_t bf(float v) {
+    auto u = sycl::bit_cast<uint32_t>(v);
+    return (uint16_t) ((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
+}
+inline void write_norm(sycl::queue& q, float* r, const float* bo, const float* inj, int stride, const float* weight,
+                       float eps, float* rs, uint16_t* hi, uint16_t* lo, int rows, int image_stride) {
+    constexpr int F = 2, SG = 16, threads = 256 / F;
+    q.submit([&](sycl::handler& cgh) {
+        sycl::local_accessor<float, 1> sums(8, cgh);
+        cgh.parallel_for(sycl::nd_range<1>{size_t(rows) * HC * threads, threads},
+                         [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
+            const int row = int(it.get_group(0)), t = row / HC, c = row % HC, id = int(it.get_local_id(0));
+            auto sg = it.get_sub_group();
+            const float sc = 2.0f * (1.0f / (1.0f + sycl::native::exp(-(inj[t * stride + c] / (float) HC))));
+            using Vec = sycl::vec<float, F>;
+            Vec v[10];
+            float ss[F] = {0.0f, 0.0f};
+#pragma unroll
+            for (int k = 0; k < 10; ++k) {
+                const int d = 256 * k + id * F;
+                const Vec b = *reinterpret_cast<const Vec*>(bo + size_t(t) * N + d);
+                Vec* dest = reinterpret_cast<Vec*>(r + size_t(row) * N + d);
+                const Vec old = *dest;
+                Vec x;
+#pragma unroll
+                for (int j = 0; j < F; ++j) {
+                    x[j] = sycl::fma(b[j], sc, old[j]);
+                    ss[j] += x[j] * x[j];
+                }
+                *dest = x;
+                v[k] = x;
+            }
+#pragma unroll
+            for (int off = 16 / F; off; off /= 2)
+#pragma unroll
+                for (int j = 0; j < F; ++j) ss[j] += sycl::permute_group_by_xor(sg, ss[j], off);
+            ss[0] += ss[1];
+            if ((id * F) % 32 == 0) sums[id * F / 32] = ss[0];
+            it.barrier(sycl::access::fence_space::local_space);
+            const int lane = int(sg.get_local_linear_id());
+            float part = lane < 8 ? sums[lane] : 0.0f;
+#pragma unroll
+            for (int off = 4; off; off /= 2) part += sycl::permute_group_by_xor(sg, part, off);
+            const float inv = sycl::rsqrt(sycl::group_broadcast(sg, part, 0) / (float) N + eps);
+            if (id == 0) rs[row] = inv;
+#pragma unroll
+            for (int k = 0; k < 10; ++k) {
+                const int d = k * 256 + id * F;
+                const Vec wv = *reinterpret_cast<const Vec*>(weight + c * N + d);
+                sycl::vec<uint16_t, F> upper, lower;
+#pragma unroll
+                for (int j = 0; j < F; ++j) {
+                    const float x = v[k][j] * inv * wv[j];
+                    upper[j] = bf(x);
+                    lower[j] = bf(x - sycl::bit_cast<float>(uint32_t(upper[j]) << 16));
+                }
+                const size_t o = size_t(t) * image_stride + c * N + d;
+                *reinterpret_cast<sycl::vec<uint16_t, F>*>(hi + o) = upper;
+                if (lo) *reinterpret_cast<sycl::vec<uint16_t, F>*>(lo + o) = lower;
+            }
+        });
+    });
+}
+}  // namespace strata::prefill::b70_gdn_residual
