+inline bool night_grouped_type(int t) { return t == 16 || t == 17 || t == 18 || t == 20 || t == 21 || t == 22 || t == 42; }
+inline bool night_grouped_layer_ok(int gt, int dt) { return night_grouped_type(gt) && night_grouped_type(dt); }
