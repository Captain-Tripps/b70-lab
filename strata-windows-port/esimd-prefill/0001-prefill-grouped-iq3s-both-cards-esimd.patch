+// one grouped pass's experts for the ESIMD GEMMs: slot, first row, rows
+struct NightEsimdSet {
+    std::vector<const void*> gw, dw;
+    std::vector<int64_t> r0;
+    std::vector<int32_t> n;
+    void clear() { gw.clear(); dw.clear(); r0.clear(); n.clear(); }
+    void add(const uint8_t* bd, uint64_t down_off, int64_t o, int32_t c) {
+        gw.push_back(bd); dw.push_back(bd + down_off); r0.push_back(o); n.push_back(c);
+    }
+};
+// gate/up + SwiGLU (+ down) of `s` on q: X [rows][N] FP16 -> GU [rows][1280] -> H [rows][640] FP16 -> Y [rows][N] FP32.
+// 0: nothing launched (the caller's own path does all of it); 1: all done; 2: H is ready, down is the caller's (a down
+// type the ESIMD GEMM does not take, Q2_0). Counters for the timing summary.
+inline int64_t g_night_esimd_gu = 0, g_night_esimd_d = 0, g_night_esimd_no = 0;
+template <typename Mid> inline int night_esimd_ffn(Mid&& mid, sycl::queue* q, int gu_type, int d_type, bool stacked, NightEsimdSet& s, const uint16_t* X,
+                           float* GU, uint16_t* H, float* Y, int64_t rows, int N) {
+#ifdef STRATA_ESIMD
+    // first outcome of each (gate/up, down) type pair to stderr, so a run shows where ESIMD engaged
+    static std::mutex mu;
+    static std::set<int> seen;
+    auto note = [&](int rc) {
+        std::lock_guard<std::mutex> g(mu);
+        if (seen.insert(gu_type * 1000 + d_type).second)
+            std::fprintf(stderr, "strata: night ESIMD gate/up type %d down type %d stacked %d: %s\n", gu_type, d_type, (int) stacked,
+                         rc == 1 ? "both ESIMD" : rc == 2 ? "gate/up ESIMD, down night_grouped" : "night_grouped");
+    };
+    if (!night_esimd() || !stacked || s.n.empty()) { ++g_night_esimd_no; note(0); return 0; }
+    const int ne = (int) s.n.size();
+    if (!strata_esimd_grouped(q, gu_type, s.gw.data(), s.r0.data(), s.n.data(), ne, X, GU, 1280, N)) { ++g_night_esimd_no; note(0); return 0; }
+    ++g_night_esimd_gu;
+    mid();   // a timeline mark between gate/up and the rest
+    strata_swiglu_split(GU, H, rows, q);
+    if (!strata_esimd_grouped(q, d_type, s.dw.data(), s.r0.data(), s.n.data(), ne, H, Y, N, 640)) { note(2); return 2; }
+    ++g_night_esimd_d;
+    note(1);
+    return 1;
+#else
+    (void) mid; (void) q; (void) gu_type; (void) d_type; (void) stacked; (void) s; (void) X; (void) GU; (void) H; (void) Y; (void) rows; (void) N;
+    return 0;
+#endif
+}
+// night lab: the grouped entry tables go up from a ring of pinned host buffers (STRATA_NIGHT_PREFILL_PINNED_UP, default 1).
+// A copy from pageable host memory can hold the host thread until the queue reaches it, and under HALVES that host
+// thread also queues the other card's half; a pinned source lets the copy be truly asynchronous. A slot is reused
+// only after its copy has finished.
+inline bool night_pinned_up() {
+    static const bool v = [] { const char* e = std::getenv("STRATA_NIGHT_PREFILL_PINNED_UP"); return !e || std::atoi(e) != 0; }();
+    return v;
+}
+inline void night_upload(sycl::queue* q, void* dst, const void* src, size_t bytes) {
+    if (bytes == 0) return;
+    if (!night_pinned_up()) { q->memcpy(dst, src, bytes); return; }
+    struct Slot { void* p = nullptr; size_t cap = 0; sycl::event done; };
+    struct Ring { Slot s[8]; int next = 0; };
+    static std::mutex mu;
+    static std::map<sycl::queue*, Ring> rings;
+    std::lock_guard<std::mutex> g(mu);
+    Ring& r = rings[q];
+    Slot& s = r.s[r.next];
+    r.next = (r.next + 1) % 8;
+    s.done.wait();
+    if (s.cap < bytes) {
+        if (s.p) sycl::free(s.p, *q);
+        s.cap = bytes + bytes / 4 + 4096;
+        s.p = sycl::malloc_host(s.cap, *q);
+        if (!s.p) { s.cap = 0; q->memcpy(dst, src, bytes).wait(); return; }
+    }
+    std::memcpy(s.p, src, bytes);
+    s.done = q->memcpy(dst, s.p, bytes);
+}
