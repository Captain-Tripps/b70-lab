+// night lab ESIMD (STRATA_NIGHT_PREFILL_ESIMD=1, a build with STRATA_ESIMD): the grouped pass's GEMMs on the llama.cpp
+// SYCL fork's ESIMD grouped dequant GEMM (strata_esimd_shim.cpp) where it covers the type, else night_grouped_f16 as
+// before. Gate/up go as one 1280-row GEMM (gate and up stacked in the slot), so the activation uses the split layout.
+#ifdef STRATA_ESIMD
+extern "C" int strata_esimd_grouped(void* q, int type, const void* const* w, const int64_t* row0, const int32_t* rows,
+                                    int n_ent, const uint16_t* x, float* y, int M, int K);
+extern "C" void strata_swiglu_split(const float* gu, uint16_t* h16, int64_t n, void* q);
+#endif
