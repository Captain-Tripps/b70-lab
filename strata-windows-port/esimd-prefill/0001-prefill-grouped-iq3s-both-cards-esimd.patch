+#ifdef STRATA_ESIMD
+    static const bool v = [] {
+        const char* e = std::getenv("STRATA_NIGHT_PREFILL_ESIMD");
+        return e != nullptr && std::atoi(e) != 0;
+    }();
+    return v;
+#else
+    return false;
+#endif
