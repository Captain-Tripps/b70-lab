+#if defined(_WIN32)
+/// Windows port: Level Zero on Windows has no IPC handles and no peer access between Arc cards (measured on two
+/// B70s: zeMemGetIpcHandle 0x78000003, zeDeviceCanAccessPeer 0, a kernel on the other card's memory: device lost).
+/// The two cards' shared regions (strata/core/ep_mem.hpp) are therefore host memory, which both cards' kernels can
+/// use only inside ONE context: every GPU of a platform shares one sycl::context here.
+/// STRATA_WIN_SHARED_CONTEXT=0 gives each device its own context again (as on Linux).
+inline sycl::context strata_device_context(const sycl::device &d) {
+  const char *e = std::getenv("STRATA_WIN_SHARED_CONTEXT");
+  if ((e != nullptr && e[0] == '0') || !d.is_gpu()) return sycl::context(d);
+  static std::mutex mu;
+  static std::vector<std::pair<sycl::platform, sycl::context>> made;
+  std::lock_guard<std::mutex> g(mu);
+  const sycl::platform p = d.get_platform();
+  for (auto &m : made)
+    if (m.first == p) return m.second;
+  made.emplace_back(p, sycl::context(p.get_devices(sycl::info::device_type::gpu)));
+  return made.back().second;
+}
+#else
+inline sycl::context strata_device_context(const sycl::device &d) { return sycl::context(d); }
+#endif
