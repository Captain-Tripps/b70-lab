+#if defined(_WIN32)
+// Windows: ::open / ::close are the CRT's; pread is a positioned ReadFile on the descriptor's handle (no file
+// position, no text-mode translation). off_t is 32-bit there, so this file's offsets use a 64-bit type.
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+#define off_t long long
+#define ssize_t long long
+static long long pread(int fd, void* buf, size_t n, long long off) {
+    HANDLE h = (HANDLE) _get_osfhandle(fd);
+    if (h == INVALID_HANDLE_VALUE) return -1;
+    OVERLAPPED ov{};
+    ov.Offset = (DWORD) ((unsigned long long) off & 0xffffffffu);
+    ov.OffsetHigh = (DWORD) ((unsigned long long) off >> 32);
+    DWORD got = 0;
+    const DWORD want = n > 0x40000000u ? 0x40000000u : (DWORD) n;
+    if (!ReadFile(h, buf, want, &got, &ov)) return GetLastError() == ERROR_HANDLE_EOF ? 0 : -1;
+    return (long long) got;
+}
+#endif
