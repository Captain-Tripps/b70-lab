+// The layer waits for a helper on the CPU pool's critical path, once per layer.  A blocking queue wait sleeps,
+// and on Windows its wake-up costs more than the helper's batch (the CUDA original spun for this reason).
+// STRATA_REMOTE_SPIN=1 polls the queue's last event instead.  STRATA_REMOTE_HOSTMETA=1 lets the kernels read
+// the group tables from the pinned host buffer, as zero-copy already does for the input and the results, so a
+// layer submits one copy fewer per helper.
+bool env_on(const char* name) {
+    const char* v = std::getenv(name);
+    return v != nullptr && v[0] == '1';
+}
+const bool g_remote_spin = env_on("STRATA_REMOTE_SPIN");
+const bool g_remote_host_meta = env_on("STRATA_REMOTE_HOSTMETA");
+
+// spin until everything submitted to the in-order queue `q` has finished
+void spin_wait(sycl::queue& q) {
+    // the return type is sycl::event in older runtimes and std::optional<sycl::event> in newer ones; a generic
+    // lambda discards the branch that does not apply (as dpct's get_in_order_queues_last_events does)
+    const auto spin = [](auto&& last) {
+        sycl::event ev;
+        if constexpr (std::is_same_v<std::remove_cv_t<std::remove_reference_t<decltype(last)>>, sycl::event>) ev = last;
+        else if (last.has_value()) ev = last.value();
+        else return;   // nothing submitted
+        while (ev.get_info<sycl::info::event::command_execution_status>() != sycl::info::event_command_status::complete)
+            _mm_pause();
+    };
+    spin(q.ext_oneapi_get_last_event());
+}
