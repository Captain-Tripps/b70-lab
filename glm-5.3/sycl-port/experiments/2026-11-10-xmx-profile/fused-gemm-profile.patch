+// Opt-in diagnostics. Retain events until prefill_destroy has waited for this queue;
+// do not insert host waits in the hot path. Each bucket belongs to one compute queue.
+struct FgTraceRow {
+    int type; int64_t m, k, rows, experts, tiles, host_ns;
+    sycl::event begin, copied, packed, done;
+};
+struct FgTraceBucket { std::vector<FgTraceRow> rows; uint64_t declined=0, dropped=0; };
+static std::mutex& fg_trace_mutex() { static auto* m=new std::mutex; return *m; }
+static std::unordered_map<void*, FgTraceBucket>& fg_trace_buckets() {
+    static auto* m=new std::unordered_map<void*, FgTraceBucket>; return *m;
+}
+static bool fg_trace_enabled() { static const bool yes=std::getenv("MAYA_XMX_PROFILE")!=nullptr; return yes; }
+extern "C" void maya_fg_profile_declined(void* q) {
+    if (!fg_trace_enabled()) return;
+    std::lock_guard<std::mutex> lock(fg_trace_mutex()); ++fg_trace_buckets()[q].declined;
+}
+extern "C" void maya_fg_profile_dump(void* q, int dev) {
+    if (!fg_trace_enabled()) return;
+    FgTraceBucket bucket;
+    { std::lock_guard<std::mutex> lock(fg_trace_mutex());
+      auto& all=fg_trace_buckets(); auto it=all.find(q); if (it==all.end()) return;
+      bucket=std::move(it->second); all.erase(it); }
+    struct Sum { uint64_t count=0; int64_t rows=0, experts=0, tiles=0, host_ns=0; double copy=0, pack=0, gemm=0; };
+    std::map<std::tuple<int,int64_t,int64_t>,Sum> sums;
+    try {
+        for (auto& r:bucket.rows) {
+            auto& z=sums[{r.type,r.m,r.k}]; ++z.count; z.rows+=r.rows; z.experts+=r.experts;
+            z.tiles+=r.tiles; z.host_ns+=r.host_ns;
+            auto end=[](const sycl::event& e) { return e.get_profiling_info<sycl::info::event_profiling::command_end>(); };
+            auto a=end(r.begin), b=end(r.copied), c=end(r.packed), d=end(r.done);
+            if (a>b || b>c || c>d) throw std::runtime_error("non-monotonic XMX event timestamps");
+            z.copy+=double(b-a)/1e6; z.pack+=double(c-b)/1e6; z.gemm+=double(d-c)/1e6;
+        }
+        std::fprintf(stderr,"xmx profile CUDA%d: accepted=%zu declined=%llu dropped=%llu\n",dev,bucket.rows.size(),(unsigned long long)bucket.declined,(unsigned long long)bucket.dropped);
+        for (const auto& kv:sums) { const auto& z=kv.second;
+            std::fprintf(stderr,"  type=%d M=%lld K=%lld calls=%llu rows=%lld experts=%lld tiles=%lld host_tiles_ms=%.3f copy_ms=%.3f pack_ms=%.3f gemm_ms=%.3f\n",
+                std::get<0>(kv.first),(long long)std::get<1>(kv.first),(long long)std::get<2>(kv.first),
+                (unsigned long long)z.count,(long long)z.rows,(long long)z.experts,(long long)z.tiles,double(z.host_ns)/1e6,z.copy,z.pack,z.gemm);
+        }
+    } catch (const std::exception& e) { std::fprintf(stderr,"xmx profile CUDA%d ERROR: %s\n",dev,e.what()); }
+}
+
