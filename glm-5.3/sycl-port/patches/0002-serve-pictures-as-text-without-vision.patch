 # ------------------------------------------------------------------------------------------------ engines
+
+def _media_as_text(messages):
+    """The conversation with each picture or video replaced by a short note, for a server without a vision encoder:
+    agents send pictures to text-only models (OpenCode reads back its own screenshots), and one picture left in the
+    history would otherwise fail every later request of the session."""
+    out = []
+    for m in messages:
+        c = m.get("content")
+        if isinstance(c, list) and any(isinstance(i, dict) and i.get("type") in ("image", "video") for i in c):
+            m = {**m, "content": "\n".join(
+                i.get("text", "") if i.get("type") == "text"
+                else f"[{i['type']} omitted: this model has no vision encoder and cannot see it]"
+                for i in c if isinstance(i, dict) and i.get("type") in ("text", "image", "video"))}
+        out.append(m)
+    return out
+
 class Engine(Protocol):
