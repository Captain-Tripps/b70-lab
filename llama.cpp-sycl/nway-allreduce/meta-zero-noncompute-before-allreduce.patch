diff --git a/ggml/src/ggml-backend-meta.cpp b/ggml/src/ggml-backend-meta.cpp
--- a/ggml/src/ggml-backend-meta.cpp
+++ b/ggml/src/ggml-backend-meta.cpp
@@ -2496,6 +2496,38 @@ static enum ggml_status ggml_backend_meta_graph_compute(ggml_backend_t backend,
             }
         }
 
+        // Disabled (non-COMPUTE) slices must be zeroed before ANY allreduce path.
+        // The generic fallback already did this; backend-specific allreduce (SYCL N-way,
+        // NCCL, etc.) used to skip it, so MoE tensor-split on N>2 could sum uninitialized
+        // partials into garbage tokens (Flash-Next IQ3_S on 3x B70).
+        if (n_backends > 1 && i < backend_ctx->n_subgraphs - 1) {
+            std::vector<ggml_cgraph *> zero_cgraphs(n_backends, nullptr);
+            for (size_t j = 0; j < n_backends; j++) {
+                auto & bcj = backend_ctx->backend_configs[j];
+                ggml_tensor * node = bcj.cgraphs[i].cgraph_main->nodes[bcj.cgraphs[i].cgraph_main->n_nodes - 1];
+                if (node->flags & GGML_TENSOR_FLAG_COMPUTE) {
+                    continue;
+                }
+                if (ggml_nelements(node) > 0) {
+                    ggml_tensor * node_zero = get_node_aux(node);
+                    node_zero->op = GGML_OP_FILL;
+                    node_zero->src[0] = node; // only used for the shape, the data is not read
+                    ggml_set_op_params_f32(node_zero, 0, 0.0f);
+                    node_zero->data = node->data;
+                    node_zero->buffer = node->buffer;
+                    node_zero->flags |= GGML_TENSOR_FLAG_COMPUTE;
+
+                    zero_cgraphs[j] = get_cgraph_aux();
+                    zero_cgraphs[j]->nodes[0] = node_zero;
+                    zero_cgraphs[j]->n_nodes = 1;
+                    const ggml_status status = ggml_backend_graph_compute_async(bcj.backend, zero_cgraphs[j]);
+                    if (status != GGML_STATUS_SUCCESS) {
+                        return status;
+                    }
+                }
+            }
+        }
+
         if (n_backends > 1 && i < backend_ctx->n_subgraphs - 1) {
